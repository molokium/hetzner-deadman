# ---------------------------------------------------------------------------
# hetzner-deadman — copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# Hetzner Cloud API token, scoped to the project you want torn down.
# Read + write is required (servers, primary IPs, floating IPs, images).
HCLOUD_TOKEN=

# The main server: the one this software runs on.  Strongly recommended to set
# explicitly; otherwise it is auto-detected by hostname / local IP / sole server.
MAIN_SERVER_ID=

# Optional explicit reservation of the Primary IP(s) that must survive.
# When any of these is set it is AUTHORITATIVE: exactly those IPs are preserved
# (plus RESERVED_*), and the server's other Primary IPs — e.g. the IPv6 — are
# set to auto_delete=true and deleted together with the server.  Leave all of
# them empty to auto-preserve the main server's IPv4 (and IPv6, see below).
# MAIN_PRIMARY_IP_ID=900001
# MAIN_PRIMARY_IP_IDS=900001,900002
# MAIN_PRIMARY_IP=203.0.113.10
# Extra IDs/addresses to never delete (besides the main server's own IPs):
# RESERVED_PRIMARY_IPS=
# RESERVED_IPS=

# Reserve the main server's IPv6 /64 as well (default true).  This only applies
# to auto-detection; set false (or configure MAIN_PRIMARY_IP* explicitly) if you
# really want the IPv6 deleted with the server.
RESERVE_MAIN_IPV6=true

# --- Telegram check-in ------------------------------------------------------
# Create a bot with @BotFather, send it one message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: also accept messages from this user id (useful in group chats).
TELEGRAM_USER_ID=

# How often to ask for a check-in (hours).
CHECKIN_INTERVAL_HOURS=24

# Days of silence before teardown.  THE BIG KNOB.
GRACE_PERIOD_DAYS=7

# --- Retry tolerance --------------------------------------------------------
# Wait one hour between attempts of a failed step.
RETRY_INTERVAL_SECONDS=3600
# Give up on a step after this many hours and move to the next one.
MAX_RETRY_HOURS=6
# If true (default), a step that exhausts its retry window is skipped and the
# flow advances.  The alternative would be to stall forever.
SKIP_STEP_AFTER_MAX_RETRY_HOURS=true

# Safety gate: refuse to delete the main server unless a snapshot is available.
# Default false, matching the explicit instruction not to be billed forever if
# snapshot creation is broken; set true if the snapshot matters more than the
# guaranteed teardown.
REQUIRE_SNAPSHOT_BEFORE_MAIN_DELETE=false

# Any Telegram message during teardown aborts it before the main server delete.
ABORT_ON_MESSAGE_DURING_TEARDOWN=true

# --- Billing (optional, never blocks teardown) ------------------------------
# Hetzner has NO payment API. Credit is applied automatically. A hook is the
# only option; leave mode=auto to disable when both values are empty.
BILLING_MODE=auto
# BILLING_WEBHOOK_URL=https://example.com/deadman-billing
# BILLING_COMMAND=/usr/local/bin/my-billing-hook --run deadman
BILLING_TIMEOUT_SECONDS=30

# --- State ------------------------------------------------------------------
# Inside Docker this is the mounted volume.  Keep it persistent!
STATE_DIR=/data
ENABLE_BLOCK_FILE=true
BLOCK_FILE_SIZE_MB=4

# --- Behaviour --------------------------------------------------------------
# Keep false in production.  When true every destructive call is logged, not sent.
DRY_RUN=false
LOG_LEVEL=INFO

# Optional: touching this file resets the timer (in addition to Telegram).
# HEARTBEAT_FILE=/data/heartbeat

# Scope every list/delete to servers with this label (leave empty for project).
# LABEL_SELECTOR=deadman=managed
